      "typeVersion": 1.4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://hnrss.org/frontpage",
        "options": {}
      },
      "id": "75e1fab2-57e6-4f3f-97f7-07d2f89d579b",
      "name": "Read RSS Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {},
      "id": "b2a47779-6838-47ee-9aaf-ef28b73a5772",
      "name": "Limit To Latest",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "content": "=Aşağıdaki bilimsel makale açıklamasını değerlendir.\n\n1) Makalenin yeniliğini (novelty) ve alaka düzeyini (relevance) birlikte değerlendirerek 1 ile 10 arasında tek bir tam sayı puan ver.\n2) Açıklamayı Türkçe olarak tam 3 kısa madde halinde özetle. Her madde \"- \" ile başlasın.\n\nAçıklama:\n{{ $json.contentSnippet || $json.content }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 500,
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "paper_evaluation",
              "schema": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"score\",\"summary\"],\"properties\":{\"score\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":10,\"description\":\"Yenilik ve alaka düzeyi için 1-10 arası tam sayı puan\"},\"summary\":{\"type\":\"string\",\"description\":\"Türkçe 3 maddelik özet, her madde \\\"- \\\" ile başlar ve satır sonuyla ayrılır\"}}}",
              "strict": true
            }
          }
        }
      },
      "id": "6e3341bc-70c0-41c0-ad58-3f0e772850f6",
      "name": "Summarize In Turkish",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        672,
        0
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "score-threshold",
              "leftValue": "={{ $json.output[0].content[0].text.score }}",
              "rightValue": 7,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "27b58c68-8377-4427-916f-f2069012cd4b",
      "name": "Score 7 Or Higher",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        896,
        192
      ]
    },
    {
      "parameters": {
        "resource": "audio",
        "input": "={{ $json.output[0].content[0].text.summary }}",
        "voice": "nova",
        "options": {
          "response_format": "mp3",
          "binaryPropertyOutput": "data"
        }
      },
      "id": "24270d58-e660-4ea9-960a-35eb9ca2a59d",
      "name": "Generate Speech",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
