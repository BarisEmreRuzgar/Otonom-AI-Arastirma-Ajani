        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "operation": "sendAudio",
        "chatId": "8522497206",
        "binaryData": true,
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "📄 ArXiv Makalesini Aç",
                    "additionalFields": {
                      "url": "={{ $(\"Read RSS Feed\").item.json.link }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "caption": "=⭐ Skor: {{ $(\"Summarize In Turkish\").item.json.output[0].content[0].text.score }}/10\n\n<b>{{ $(\"Read RSS Feed\").item.json.title.replaceAll(\"&\",\"&amp;\").replaceAll(\"<\",\"&lt;\").replaceAll(\">\",\"&gt;\") }}</b>\n\n{{ $(\"Summarize In Turkish\").item.json.output[0].content[0].text.summary.replaceAll(\"&\",\"&amp;\").replaceAll(\"<\",\"&lt;\").replaceAll(\">\",\"&gt;\") }}\n\n{{ $(\"Read RSS Feed\").item.json.link.replaceAll(\"&\",\"&amp;\").replaceAll(\"<\",\"&lt;\").replaceAll(\">\",\"&gt;\") }}",
          "fileName": "ozet.mp3",
          "parse_mode": "HTML",
          "performer": "ArXiv Araştırma Ajanı",
          "title": "={{ $(\"Read RSS Feed\").item.json.title }}"
        }
      },
      "id": "8a59c13e-3318-4233-8889-769c7617e986",
      "name": "Send Telegram Message",
